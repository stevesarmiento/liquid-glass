{
  "name": "liquid-glass-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Research-to-implementation workspace for a reusable liquid-glass rendering system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevesarmiento/liquid-glass.git"
  },
  "bugs": {
    "url": "https://github.com/stevesarmiento/liquid-glass/issues"
  },
  "homepage": "https://github.com/stevesarmiento/liquid-glass#readme",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:all": "turbo run build build:wasm",
    "build:wasm": "turbo run build:wasm",
    "test": "cargo test && turbo run test",
    "test:wasm": "cd packages/liquid-glass && bun run test:wasm",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish",
    "playground": "cd packages/playground && bun run dev",
    "docs": "cd packages/docs && bun run dev",
    "download": "node scripts/download.mjs",
    "extract:sourcemaps": "node scripts/extract-sourcemaps.mjs",
    "prototype": "node scripts/serve-prototype.mjs",
    "prettify": "node scripts/prettify.mjs",
    "search": "node scripts/search.mjs",
    "summarize": "node scripts/summarize.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^7.0.2"
  }
}
