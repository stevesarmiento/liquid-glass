{
  "name": "liquid-glass",
  "version": "0.1.0",
  "private": false,
  "description": "Universal liquid-glass engine, renderers, and React primitives.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevesarmiento/liquid-glass.git",
    "directory": "packages/liquid-glass"
  },
  "bugs": {
    "url": "https://github.com/stevesarmiento/liquid-glass/issues"
  },
  "homepage": "https://github.com/stevesarmiento/liquid-glass/tree/main/packages/liquid-glass#readme",
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "svg-filter",
    "webgl",
    "wasm",
    "react"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./styles.css": "./dist/react/index.css"
  },
  "imports": {
    "#wasm": "./wasm/liquid_glass_core.js"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "wasm",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:wasm": "wasm-pack build ../../crates/core --target web --out-dir ../../packages/liquid-glass/wasm --out-name liquid_glass_core",
    "test:wasm": "wasm-pack test --node ../../crates/core"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^30.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
