{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:wasm": {
      "inputs": ["$TURBO_ROOT$/crates/core/**", "$TURBO_ROOT$/Cargo.toml", "$TURBO_ROOT$/Cargo.lock"],
      "outputs": ["wasm/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
